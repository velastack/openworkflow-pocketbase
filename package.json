{
  "name": "openworkflow-pocketbase",
  "version": "0.1.1",
  "description": "OpenWorkflow Backend backed by a velabase /api/ow/v1 HTTP API, driven by a superuser-authed PocketBase JS SDK client.",
  "keywords": [
    "openworkflow",
    "pocketbase",
    "velabase",
    "durable execution",
    "workflow"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit.test.ts",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "pocketbase": "^0.28.1"
  },
  "peerDependencies": {
    "openworkflow": "^0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "openworkflow": "^0.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
